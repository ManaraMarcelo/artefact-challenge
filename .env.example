# --- Option A (default, free): Google Gemini ---------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Optional extra keys, used in order when a key hits its free-tier DAILY quota.
# The quota is per Google Cloud project: create each key in a NEW project.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# --- Option B: Anthropic Claude ----------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# EMPORIO_PROVIDER=anthropic

# --- Optional overrides ------------------------------------------------------
# EMPORIO_PROVIDER=gemini            # gemini | anthropic (auto-detected from keys)
# EMPORIO_MODEL=gemini-3.5-flash     # defaults: gemini-3.5-flash / claude-opus-5-5
# EMPORIO_EFFORT=low                 # Anthropic only
# Freeze "today" (YYYY-MM-DD) for reproducible demos; defaults to the real date
# EMPORIO_TODAY=2026-03-25
